  has kind "entity",
  has prefLabel "Person",
  has definition "A human actor who can participate in delivery work.",
  has scopeNote "Inherited from gist. Can serve as a performer (assignsPerformer), assigner (assignmentAllocatedBy), submitter (submissionProvidedBy), or decision actor in triage, planning, resolution, and closure relations.";
