define

# Vibe Machine workspace, product, and specification modeling
# layered on top of gist.
#
# v0.3.0: Flattened intermediate types. Specification vocabulary.
# Category-based lifecycle via SpecificationStatus.

# ── Attributes ──────────────────────────────────────────

attribute workspaceName, value string;
attribute productName, value string;
attribute repositoryName, value string;
attribute block_id, value string;
attribute document_id, value string;
attribute priority_level, value string;
attribute status_label, value string;

# ── Organizational ──────────────────────────────────────

relation usesWorkspace,
  relates project,
  relates workspace;

entity VibeWorkspace sub Collection,
  owns workspaceName,
  plays usesWorkspace:workspace;

entity VibeProduct sub System,
  owns productName,
  plays isProducedBy:isProducedBySubject,
  plays conformsTo:conformsToSubject;

entity VibeRepository sub Component,
  owns repositoryName,
  plays isMemberOf:isMemberOfSubject,
  plays contributesTo:contributesToSubject;

entity VibeProject sub Project;

Project plays usesWorkspace:project;
Project plays isProducedBy:isProducedByObject;

# ── Lifecycle ───────────────────────────────────────────
# Follows gist's Category pattern (cf. DegreeOfCommitment,
# ProductCategory). Status instances are seed data.

entity SpecificationStatus sub Category,
  owns status_label @key,
  owns name,
  plays isCategorizedBy:isCategorizedByObject;

# ── Containment ─────────────────────────────────────────

relation containsBlock,
  relates container,
  relates block;

# ── Feature Specification ───────────────────────────────
# Product-level: what does this feature do?
# Contains requirement, decision, constraint, and question blocks.
# Inherits isAbout and isCategorizedBy from ContentExpression.

entity VibeFeatureSpecification sub FormattedContent,
  owns document_id @key,
  plays containsBlock:container,
  plays isDirectPartOf:isDirectPartOfSubject,
  plays isBasedOn:isBasedOnObject;

ProductSpecification plays isDirectPartOf:isDirectPartOfObject;

entity VibeRequirement sub Requirement,
  owns block_id @key,
  owns document_id,
  owns priority_level,
  plays containsBlock:block,
  plays isCategorizedBy:isCategorizedBySubject;

entity VibeDecision sub Determination,
  owns block_id @key,
  owns document_id,
  plays containsBlock:block,
  plays isCategorizedBy:isCategorizedBySubject;

entity VibeConstraint sub Restriction,
  owns block_id @key,
  owns document_id,
  plays containsBlock:block,
  plays isCategorizedBy:isCategorizedBySubject;

entity VibeQuestion sub Intention,
  owns block_id @key,
  owns document_id,
  plays containsBlock:block,
  plays isCategorizedBy:isCategorizedBySubject;

# ── Implementation Specification ────────────────────────
# Engineering-level: how do we build it?
# Contains task, verification, and dependency blocks.
# Derived from a feature specification via isBasedOn.

entity VibeImplementationSpec sub FormattedContent,
  owns document_id @key,
  plays containsBlock:container,
  plays isBasedOn:isBasedOnSubject;

entity VibeEngineeringTask sub Task,
  owns block_id @key,
  owns document_id,
  plays containsBlock:block,
  plays isCategorizedBy:isCategorizedBySubject;

entity VibeVerification sub Specification,
  owns block_id @key,
  owns document_id,
  plays containsBlock:block,
  plays isCategorizedBy:isCategorizedBySubject;

entity VibeDependency sub Intention,
  owns block_id @key,
  owns document_id,
  plays containsBlock:block,
  plays isCategorizedBy:isCategorizedBySubject;
