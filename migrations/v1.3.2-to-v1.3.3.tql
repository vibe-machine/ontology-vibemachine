  has iri "https://github.com/vibe-machine/ontology-vibemachine#versionName",
  has typeLabel "versionName",
  has kind "attribute",
  has prefLabel "versionName",
  has definition "A released version label for a software-system version, such as 1.2.3 or 2026.03.",
  has scopeNote "Used on VibeSoftwareSystemVersion to distinguish the released version specification from the long-lived software system.";
