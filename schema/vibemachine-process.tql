# ── Process Modeling ────────────────────────────────────
# General pattern for modeling staged processes as first-class
# queryable entities in the knowledge graph.
#
# A VibeProcess is a reusable template that defines how a class
# of work moves from inception to completion. It contains an
# ordered sequence of VibeProcessStage instances, each with
# gate criteria that must be satisfied before advancement.
#
# When something passes through a gate, a VibeGateDecision
# records the transition: who decided, when, which stage
# boundary was crossed, and what rationale was given.
#
# Design principle: the process is data, not code. New processes
# can be defined by creating instances of these types without
# schema changes. The application renders any process the same
# way: as a pipeline with stages, gates, and current positions.
#
# v1.1.0: Process modeling foundation.

define

# ── Process Attributes ─────────────────────────────────

attribute process_id, value string;
attribute stage_id, value string;
attribute criteria_id, value string;
attribute stage_sequence, value integer;
attribute assignment_decision_id, value string;
attribute work_started_decision_id, value string;
attribute verification_decision_id, value string;

# ── General Process Relations ──────────────────────────

# "this process contains this stage"
relation processContainsStage sub isMemberOf,
  relates stage as isMemberOfSubject,
  relates process as isMemberOfObject;

# "this stage has this gate criterion"
relation stageHasCriterion sub conformsTo,
  relates criterion as conformsToObject,
  relates stage as conformsToSubject;

# "this gate decision advances this entity through a process"
relation gateAdvancesEntity sub isBasedOn,
  relates gateDecision as isBasedOnSubject,
  relates advancedEntity as isBasedOnObject;

# "this gate decision is for this stage transition"
relation gateTransitionsToStage sub isAbout,
  relates gateDecision as isAboutSubject,
  relates targetStage as isAboutObject;

# "this gate decision is within this process"
relation gateWithinProcess sub isAbout,
  relates gateDecision as isAboutSubject,
  relates process as isAboutObject;

# "this entity is currently at this stage"
relation currentlyAtStage sub isCategorizedBy,
  relates trackedEntity as isCategorizedBySubject,
  relates stage as isCategorizedByObject;

# ── General Process Entities ───────────────────────────

# The process template itself.
entity VibeProcess sub TaskTemplate,
  owns name,
  owns description,
  owns process_id @key,
  plays processContainsStage:process,
  plays gateWithinProcess:process;

# A named stage within a process.
entity VibeProcessStage sub Category,
  owns name,
  owns description,
  owns stage_id @key,
  owns stage_sequence,
  plays processContainsStage:stage,
  plays stageHasCriterion:stage,
  plays currentlyAtStage:stage,
  plays gateTransitionsToStage:targetStage,
  plays precedesDirectly:precedesDirectlySubject,
  plays precedesDirectly:precedesDirectlyObject;

# A criterion that must be satisfied to pass through a gate.
entity VibeGateCriterion sub Specification,
  owns name,
  owns description,
  owns criteria_id @key,
  plays stageHasCriterion:criterion;

# VibeGateDecision is defined in vibemachine.tql (loaded first)
# because decision subtypes there reference it. Here we add
# the process-specific roles it plays.
VibeGateDecision
  plays gateAdvancesEntity:gateDecision,
  plays gateTransitionsToStage:gateDecision,
  plays gateWithinProcess:gateDecision;

# ── Entity participation ───────────────────────────────
# Allow the types that move through processes to play the
# advancedEntity role and the currentlyAtStage role.

VibeFeatureSpecification
  plays gateAdvancesEntity:advancedEntity,
  plays currentlyAtStage:trackedEntity;

VibeProductSpecification
  plays gateAdvancesEntity:advancedEntity,
  plays currentlyAtStage:trackedEntity;

VibeIssue
  plays gateAdvancesEntity:advancedEntity,
  plays currentlyAtStage:trackedEntity;

VibeSubmission
  plays gateAdvancesEntity:advancedEntity,
  plays currentlyAtStage:trackedEntity;


# ══════════════════════════════════════════════════════════
# DESIGN FUNNEL
# ══════════════════════════════════════════════════════════
#
# The process that specifications move through:
#   Vision → Architecture → Specification → Implementation
#
# Product specifications enter at Vision.
# Top-level features (TLFs) enter at Architecture.
# Sub-TLFs enter at Specification.
# The execute commit gate produces implementation specs.

# ── TLF / Sub-TLF Decomposition ───────────────────────
# Feature specs can decompose into child feature specs.
# A TLF decomposes into sub-TLFs at the architecture gate.

relation decomposesFeature sub isBasedOn,
  relates childFeature as isBasedOnSubject,
  relates parentFeature as isBasedOnObject;

VibeFeatureSpecification
  plays decomposesFeature:childFeature,
  plays decomposesFeature:parentFeature;

# Scope category: distinguishes TLF from sub-TLF.
entity VibeSpecificationScope sub Category,
  owns name @key,
  plays isCategorizedBy:isCategorizedByObject;


# ══════════════════════════════════════════════════════════
# BUG TRIAGE PROCESS
# ══════════════════════════════════════════════════════════
#
# The process that bugs move through:
#
#   Submitted → Triaged → Planned → Assigned → In Progress
#            → Resolved → Verified → Closed
#
# Entity transition at triage: the input is a VibeSubmission,
# the output is a VibeIssue. Both participate as advancedEntity.
#
# Every stage transition is a conscious decision by a responsible
# actor, recorded as a VibeGateDecision subtype.

# ── New decision types ─────────────────────────────────
# All sub VibeGateDecision for polymorphic querying.

# "this assignment decision was performed by this assigner"
relation assignmentPerformedBy sub hasParticipant,
  relates assignmentDecision as hasParticipantSubject,
  relates assigner as hasParticipantObject;

# "this work-started decision was performed by this starter"
relation workStartedPerformedBy sub hasParticipant,
  relates workStartedDecision as hasParticipantSubject,
  relates starter as hasParticipantObject;

# "this verification decision was performed by this verifier"
relation verificationPerformedBy sub hasParticipant,
  relates verificationDecision as hasParticipantSubject,
  relates verifier as hasParticipantObject;

# The decision to assign an agent or engineer to an issue.
entity VibeIssueAssignmentDecision sub VibeGateDecision,
  owns assignment_decision_id @key,
  plays assignmentPerformedBy:assignmentDecision;

# "this assignment decision uses this agent profile"
relation assignmentDecisionUsesProfile sub isBasedOn,
  relates assignmentDecision as isBasedOnSubject,
  relates agentProfile as isBasedOnObject;

VibeIssueAssignmentDecision
  plays assignmentDecisionUsesProfile:assignmentDecision;

VibeAgentProfile
  plays assignmentDecisionUsesProfile:agentProfile;

# The decision that active work has begun on an issue.
entity VibeIssueWorkStartedDecision sub VibeGateDecision,
  owns work_started_decision_id @key,
  plays workStartedPerformedBy:workStartedDecision;

# The decision that a fix has been verified against
# the original reproduction path or acceptance criteria.
entity VibeIssueVerificationDecision sub VibeGateDecision,
  owns verification_decision_id @key,
  plays verificationPerformedBy:verificationDecision;

# ── Existing decision types gain process participation ──
# These are reparented to sub VibeGateDecision in vibemachine.tql.
# Here we only add the gate-specific roles they already inherit
# from VibeGateDecision via the type hierarchy.

# ── Actor participation for new decision types ─────────

Person
  plays assignmentPerformedBy:assigner,
  plays workStartedPerformedBy:starter,
  plays verificationPerformedBy:verifier;

VibeAgent
  plays assignmentPerformedBy:assigner,
  plays workStartedPerformedBy:starter,
  plays verificationPerformedBy:verifier;

Organization
  plays assignmentPerformedBy:assigner,
  plays workStartedPerformedBy:starter,
  plays verificationPerformedBy:verifier;
