put $r60 isa SchemaResource,
  has docKey "https://github.com/vibe-machine/ontology-vibemachine#VibeBlocksAppearanceSpecification",
  has iri "https://github.com/vibe-machine/ontology-vibemachine#VibeBlocksAppearanceSpecification",
  has typeLabel "VibeBlocksAppearanceSpecification",
  has kind "entity",
  has prefLabel "VibeBlocksAppearanceSpecification",
  has definition "Visual presentation metadata for a specification in the blocks editor. Stores icon, cover image, and accent color independently of specification content.",
  has scopeNote "Extends gist Specification. Owns document_id (@key), icon_name, cover_image, accent_color. Linked via blocksAppearanceForSpecification. Blocks-layer infrastructure, separable into its own ontology.";
put (resource: $r60, module: $module) isa inModule;
put (resource: $r60, group: $group_blocks) isa resourceInGroup;

put $r61 isa SchemaResource,
  has docKey "https://github.com/vibe-machine/ontology-vibemachine#BlocksDocumentState",
  has iri "https://github.com/vibe-machine/ontology-vibemachine#BlocksDocumentState",
  has typeLabel "BlocksDocumentState",
  has kind "entity",
  has prefLabel "BlocksDocumentState",
  has definition "Serialized Yjs CRDT state for collaborative editing. The editor reconstitutes its block tree from this state on load.",
  has scopeNote "Owns document_id (@key), yjs_state. Linked via blocksDocumentStateForSpecification. Blocks-layer infrastructure, separable into its own ontology.";
put (resource: $r61, module: $module) isa inModule;
put (resource: $r61, group: $group_blocks) isa resourceInGroup;
