match
  $g2 isa GeneratedArtifactRecord,
    has artifactPath "schema/package-provenance.tql",
    has artifactSha256 $g2_old_artifactSha256;
delete
  has $g2_old_artifactSha256 of $g2;
insert
  $g2 has artifactSha256 "80cd8041b4cdb3fa032a63aa7dc712317b2926ea1c74a046e5e767fefbb7dff1";

match
  $g3 isa GeneratedArtifactRecord,
    has artifactPath "data/vibemachine-schema-docs.tql",
    has artifactSha256 $g3_old_artifactSha256;
delete
  has $g3_old_artifactSha256 of $g3;
insert
  $g3 has artifactSha256 "fb29c42dfbe38fb62f67ea9f0c983289991131738c107073585d90ea67c8c38f";

match
  $r7 isa SchemaResource,
    has docKey "https://github.com/vibe-machine/ontology-vibemachine#VibeGitRepository",
    has scopeNote $r7_old_scopeNote;
delete
  has $r7_old_scopeNote of $r7;
insert
  $r7 has scopeNote "Extends VibeRepository. Categorized by VibeRepositoryHostingPlatform (GitHub, GitLab, etc.). Engineering tasks and issues can target repositories via targetsRepository and issueAboutRepository.";

match
  $r9 isa SchemaResource,
    has docKey "https://github.com/vibe-machine/ontology-vibemachine#VibeRequirement",
    has scopeNote $r9_old_scopeNote;
delete
  has $r9_old_scopeNote of $r9;
insert
  $r9 has scopeNote "Extends gist Requirement. Owns name and description. Carries priority_level. Engineering tasks fulfill requirements via fulfillsRequirement. Lifecycle tracked via isCategorizedBy VibeSpecificationStatus.";

match
  $r14 isa SchemaResource,
    has docKey "https://github.com/vibe-machine/ontology-vibemachine#VibeEngineeringTask",
    has scopeNote $r14_old_scopeNote;
delete
  has $r14_old_scopeNote of $r14;
insert
  $r14 has scopeNote "Extends gist Task. Owns name and description. Targets a repository (targetsRepository). Fulfills a requirement (fulfillsRequirement). May address one or more issues via taskAddressesIssue. May be the target of a task assignment via assignmentForTask. Loosely coupled to external task systems via externalTaskRef and VibeTaskManagementSystem category.";

match
  $r35 isa SchemaResource,
    has docKey "https://github.com/vibe-machine/ontology-vibemachine#status_label",
    has definition $r35_old_definition;
delete
  has $r35_old_definition of $r35;
insert
  $r35 has definition "A machine-readable label identifying a VibeSpecificationStatus instance.";

match
  $r35 isa SchemaResource,
    has docKey "https://github.com/vibe-machine/ontology-vibemachine#status_label",
    has scopeNote $r35_old_scopeNote;
delete
  has $r35_old_scopeNote of $r35;
insert
  $r35 has scopeNote "Used as @key on VibeSpecificationStatus.";
