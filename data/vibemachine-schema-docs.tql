  has typeLabel "VibeFeatureSpecification",
  has kind "entity",
  has prefLabel "VibeFeatureSpecification",
  has definition "A structured prose document specifying a product feature. Contains typed blocks that become identity nodes in the knowledge graph.",
  has scopeNote "Extends gist FormattedContent. Owns name and description. Motivated by a VibeBusinessObjective (motivatedBy). Part of a VibeProductSpecification (featureOfProduct). About a VibeProject (specifiesFeatureFor). Contains blocks via containsBlock.";
put (resource: $r8, module: $module) isa inModule;

