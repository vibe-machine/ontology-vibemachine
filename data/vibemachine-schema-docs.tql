  has definition "A concrete implementation work item. Represents a unit of engineering work that fulfills a requirement.",
  has scopeNote "Extends gist Task. Owns name and description. Targets a repository (targetsRepository). Fulfills a requirement (fulfillsRequirement). Loosely coupled to external task systems via externalTaskRef and TaskManagementSystem category.";
put (resource: $r14, module: $module) isa inModule;

put $r15 isa SchemaResource,
