define

# Vibe Machine workspace and product modeling layered on top of gist.

attribute workspaceName value string;
attribute productName value string;
attribute repositoryName value string;

relation usesWorkspace,
  relates project,
  relates workspace;

entity Workspace sub Collection,
  owns workspaceName,
  plays usesWorkspace:workspace;

entity VibeWorkspace sub Workspace;

entity Product sub System,
  owns productName,
  plays isProducedBy:isProducedBySubject,
  plays conformsTo:conformsToSubject;

entity VibeProduct sub Product;

entity Repository sub Component,
  owns repositoryName,
  plays isMemberOf:isMemberOfSubject,
  plays contributesTo:contributesToSubject;

entity VibeRepository sub Repository;

entity VibeProject sub Project;

Project plays usesWorkspace:project;
Project plays isProducedBy:isProducedByObject;
