# ── Notes & Todo Items ──────────────────────────────────
# A lightweight note-taking layer for personal reminders
# and to-do tracking. Notes are rich block-editor documents;
# todo items are standalone completable entities.
#
# v1.2.0: Initial notes and todo item types.
# v1.3.0: Make VibeTodoItem standalone. Notes can reference
# todo items via noteReferencesTodo, but todo items exist
# independently.
#
# Design principle: VibeNote follows the same FormattedContent
# pattern as VibeFeatureSpecification — it gets block editor
# support (Yjs CRDT state, appearance metadata) via document_id.
# VibeTodoItem is a standalone entity keyed by item_id.

define

# ── Attributes ──────────────────────────────────────────

attribute due_date, value datetime;
attribute url, value string;
attribute todo_id, value string;

# ── Specialized Relations ───────────────────────────────

# "this note references this todo item"
relation noteReferencesTodo sub isAbout,
  relates note as isAboutSubject,
  relates todoItem as isAboutObject;

# ── Categories ──────────────────────────────────────────

entity VibeTodoStatus sub Category,
  owns name @key,
  plays isCategorizedBy:isCategorizedByObject;

entity VibeTodoPriority sub Category,
  owns name @key,
  plays isCategorizedBy:isCategorizedByObject;

entity VibeTag sub Category,
  owns name @key,
  plays isCategorizedBy:isCategorizedByObject;

# ── Note ────────────────────────────────────────────────
# A rich-text document authored in the block editor.

entity VibeNote sub FormattedContent,
  owns name,
  owns description,
  owns document_id @key,
  plays containsItem:container,
  plays blocksAppearanceForSpecification:specification,
  plays blocksDocumentStateForSpecification:specification,
  plays noteReferencesTodo:note;

# ── Todo Item ───────────────────────────────────────────
# A standalone completable item. Can optionally be
# referenced from a note, but exists independently.

entity VibeTodoItem sub Intention,
  owns name,
  owns description,
  owns todo_id @key,
  owns due_date,
  owns url,
  owns priority_level,
  plays noteReferencesTodo:todoItem,
  plays isCategorizedBy:isCategorizedBySubject;
