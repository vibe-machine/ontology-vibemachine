define

# Vibe Machine workspace, product, and specification modeling
# layered on top of gist.
#
# v0.5.0: Rename block terminology to implementation-neutral names.
# block_id → item_id, containsBlock → containsItem, block → item.
# Add VibeEval entity.
#
# v0.4.1: Add owns name / owns description to document and content item types
# so the Producer publish pipeline can store text content.
#
# v0.4.0: Domain-specific relation specializations. Business objectives.
# Repository typing. Full brownfield-first product model.
#
# Design principle: every gist relation used is specialized with
# natural-language role names so the model reads like English.

# ── Attributes ──────────────────────────────────────────

attribute workspaceName, value string;
attribute productName, value string;
attribute repositoryName, value string;
attribute remoteUrl, value string;
attribute defaultBranch, value string;
attribute item_id, value string;
attribute document_id, value string;
attribute priority_level, value string;
attribute status_label, value string;
attribute externalTaskRef, value string;

# ── Specialized Relations ───────────────────────────────
# Each specializes a gist relation with domain-specific role names.
# Generic gist queries still work via polymorphism.

# "this feature is motivated by this business objective"
relation motivatedBy sub isBasedOn,
  relates featureSpec as isBasedOnSubject,
  relates objective as isBasedOnObject;

# "this implementation spec implements this feature spec"
relation implementsFeature sub isBasedOn,
  relates implementationSpec as isBasedOnSubject,
  relates featureSpec as isBasedOnObject;

# "this engineering task fulfills this requirement"
relation fulfillsRequirement sub isBasedOn,
  relates engineeringTask as isBasedOnSubject,
  relates requirement as isBasedOnObject;

# "this feature spec is for this project"
relation specifiesFeatureFor sub isAbout,
  relates featureSpec as isAboutSubject,
  relates project as isAboutObject;

# "this engineering task targets this repository"
relation targetsRepository sub isAbout,
  relates engineeringTask as isAboutSubject,
  relates repository as isAboutObject;

# "this feature is part of this product specification"
relation featureOfProduct sub isDirectPartOf,
  relates featureSpec as isDirectPartOfSubject,
  relates productSpec as isDirectPartOfObject;

# "this product is produced by this project"
relation producesProduct sub isProducedBy,
  relates product as isProducedBySubject,
  relates project as isProducedByObject;

# "this product conforms to this product specification"
relation productConformsTo sub conformsTo,
  relates product as conformsToSubject,
  relates productSpec as conformsToObject;

# "this repository belongs to this workspace"
relation belongsToWorkspace sub isMemberOf,
  relates repository as isMemberOfSubject,
  relates workspace as isMemberOfObject;

# ── Original Relations ──────────────────────────────────

# "this project uses this workspace"
relation usesWorkspace,
  relates project,
  relates workspace;

# "this specification document contains this content item"
relation containsItem,
  relates container,
  relates item;

# ── Categories ──────────────────────────────────────────

entity SpecificationStatus sub Category,
  owns status_label @key,
  owns name,
  plays isCategorizedBy:isCategorizedByObject;

entity RepositoryHostingPlatform sub Category,
  owns name,
  plays isCategorizedBy:isCategorizedByObject;

entity TaskManagementSystem sub Category,
  owns name,
  plays isCategorizedBy:isCategorizedByObject;

# ── Business Intent ─────────────────────────────────────
# Why: the aspiration that drives product work.

entity VibeBusinessObjective sub Intention,
  owns name,
  owns description,
  plays motivatedBy:objective;

# ── Organizational ──────────────────────────────────────

entity VibeWorkspace sub Collection,
  owns workspaceName,
  owns description,
  plays usesWorkspace:workspace,
  plays belongsToWorkspace:workspace;

entity VibeProject sub Project,
  owns name,
  owns description,
  plays usesWorkspace:project,
  plays producesProduct:project,
  plays specifiesFeatureFor:project;

entity VibeProduct sub System,
  owns productName,
  owns description,
  plays producesProduct:product,
  plays productConformsTo:product;

entity VibeProductSpecification sub ProductSpecification,
  owns name,
  plays productConformsTo:productSpec,
  plays featureOfProduct:productSpec;

entity VibeRepository sub Component,
  owns repositoryName,
  owns description,
  plays belongsToWorkspace:repository,
  plays contributesTo:contributesToSubject;

entity VibeGitRepository sub VibeRepository,
  owns remoteUrl,
  owns defaultBranch,
  plays targetsRepository:repository,
  plays isCategorizedBy:isCategorizedBySubject;

# ── Feature Specification ───────────────────────────────
# What: product-level, what does this feature do?
# Contains requirement, decision, constraint, and question items.

entity VibeFeatureSpecification sub FormattedContent,
  owns name,
  owns description,
  owns document_id @key,
  plays containsItem:container,
  plays featureOfProduct:featureSpec,
  plays motivatedBy:featureSpec,
  plays specifiesFeatureFor:featureSpec,
  plays implementsFeature:featureSpec;

entity VibeRequirement sub Requirement,
  owns name,
  owns description,
  owns item_id @key,
  owns document_id,
  owns priority_level,
  plays containsItem:item,
  plays isCategorizedBy:isCategorizedBySubject,
  plays fulfillsRequirement:requirement;

entity VibeDecision sub Determination,
  owns name,
  owns description,
  owns item_id @key,
  owns document_id,
  plays containsItem:item,
  plays isCategorizedBy:isCategorizedBySubject;

entity VibeConstraint sub Restriction,
  owns name,
  owns description,
  owns item_id @key,
  owns document_id,
  plays containsItem:item,
  plays isCategorizedBy:isCategorizedBySubject;

entity VibeQuestion sub Intention,
  owns name,
  owns description,
  owns item_id @key,
  owns document_id,
  plays containsItem:item,
  plays isCategorizedBy:isCategorizedBySubject;

# ── Implementation Specification ────────────────────────
# How: engineering-level, how do we build it?
# Contains task, verification, eval, and dependency items.

entity VibeImplementationSpecification sub FormattedContent,
  owns name,
  owns description,
  owns document_id @key,
  plays containsItem:container,
  plays implementsFeature:implementationSpec;

entity VibeEngineeringTask sub Task,
  owns name,
  owns description,
  owns item_id @key,
  owns document_id,
  owns externalTaskRef,
  plays containsItem:item,
  plays isCategorizedBy:isCategorizedBySubject,
  plays fulfillsRequirement:engineeringTask,
  plays targetsRepository:engineeringTask;

entity VibeVerification sub Specification,
  owns name,
  owns description,
  owns item_id @key,
  owns document_id,
  plays containsItem:item,
  plays isCategorizedBy:isCategorizedBySubject;

entity VibeEval sub Specification,
  owns name,
  owns description,
  owns item_id @key,
  owns document_id,
  plays containsItem:item,
  plays isCategorizedBy:isCategorizedBySubject;

entity VibeDependency sub Intention,
  owns name,
  owns description,
  owns item_id @key,
  owns document_id,
  plays containsItem:item,
  plays isCategorizedBy:isCategorizedBySubject;
