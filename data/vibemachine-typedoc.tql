insert

$workspace_doc isa TypeDoc,
  has typeLabel "Workspace",
  has typeKind "entity",
  has definition "A structural collection of repos, infrastructure, accounts, environments, and other resources allocated to ongoing work.",
  has usageNote "Use Workspace for the container of resources. It is not the project itself. Projects use a workspace while work is active.";

$product_doc isa TypeDoc,
  has typeLabel "Product",
  has typeKind "entity",
  has definition "A delivered software system produced by project work and evaluated against an agreed specification.",
  has usageNote "Use Product for the thing a customer ships or operates. Products are produced by a Project and conform to ProductSpecification.";

$repository_doc isa TypeDoc,
  has typeLabel "Repository",
  has typeKind "entity",
  has definition "A source-code component that belongs to a workspace and contributes to a delivered product.",
  has usageNote "Repository is the resource-level model for git repos and related code containers inside a workspace.";

$product_spec_doc isa TypeDoc,
  has typeLabel "ProductSpecification",
  has typeKind "entity",
  has definition "The specification that describes what a delivered software product is expected to satisfy.",
  has usageNote "Use ProductSpecification for the promised shape of delivery. Pair it with Product via conformsTo.";

$uses_workspace_doc isa TypeDoc,
  has typeLabel "usesWorkspace",
  has typeKind "relation",
  has definition "Associates a project with the workspace of resources allocated to that work.",
  has usageNote "Roles: project (the gist Project doing the work), workspace (the resource collection supporting it).";

$is_produced_by_doc isa TypeDoc,
  has typeLabel "isProducedBy",
  has typeKind "relation",
  has definition "Associates a delivered product with the project that produced it.",
  has usageNote "Read this as Product isProducedBy Project. It keeps the project/product distinction explicit in the graph.";

$conforms_to_doc isa TypeDoc,
  has typeLabel "conformsTo",
  has typeKind "relation",
  has definition "Associates a delivered product with the specification it is expected to satisfy.",
  has usageNote "Use this to link Product to ProductSpecification without collapsing the deliverable and the promise into one type.";
