  has scopeNote "Seed instances include defect, feature-request, support-request, question, improvement, and incident. Linked to issues via isCategorizedBy.";
put (resource: $r30a, module: $module) isa inModule;
put (resource: $r30a, group: $group_reference) isa resourceInGroup;

put $r30b isa SchemaResource,
  has docKey "https://github.com/vibe-machine/ontology-vibemachine#VibeIssueStatus",
  has iri "https://github.com/vibe-machine/ontology-vibemachine#VibeIssueStatus",
  has typeLabel "VibeIssueStatus",
  has kind "entity",
  has prefLabel "VibeIssueStatus",
  has definition "A category indicating where an issue is in its lifecycle.",
  has scopeNote "Seed instances include triaged, planned, in-progress, resolved, and closed. Submission is modeled on VibeSubmission, not as an issue status.";
put (resource: $r30b, module: $module) isa inModule;
put (resource: $r30b, group: $group_reference) isa resourceInGroup;

put $r30c isa SchemaResource,
  has docKey "https://github.com/vibe-machine/ontology-vibemachine#VibeIssuePriority",
  has iri "https://github.com/vibe-machine/ontology-vibemachine#VibeIssuePriority",
  has typeLabel "VibeIssuePriority",
  has kind "entity",
  has prefLabel "VibeIssuePriority",
  has definition "A category indicating how urgently an issue should be worked.",
  has scopeNote "Seed instances include critical, high, medium, low, and backlog.";
put (resource: $r30c, module: $module) isa inModule;
put (resource: $r30c, group: $group_reference) isa resourceInGroup;

put $r30d isa SchemaResource,
  has docKey "https://github.com/vibe-machine/ontology-vibemachine#VibeIssueSeverity",
  has iri "https://github.com/vibe-machine/ontology-vibemachine#VibeIssueSeverity",
  has typeLabel "VibeIssueSeverity",
  has kind "entity",
  has prefLabel "VibeIssueSeverity",
  has definition "A category indicating the seriousness or impact of an issue.",
  has scopeNote "Seed instances include blocker, critical, major, minor, and trivial.";
put (resource: $r30d, module: $module) isa inModule;
put (resource: $r30d, group: $group_reference) isa resourceInGroup;

put $r30e isa SchemaResource,
  has docKey "https://github.com/vibe-machine/ontology-vibemachine#VibeIssueResolution",
  has iri "https://github.com/vibe-machine/ontology-vibemachine#VibeIssueResolution",
  has typeLabel "VibeIssueResolution",
  has kind "entity",
  has prefLabel "VibeIssueResolution",
  has definition "A category indicating how an issue was resolved or otherwise disposed of.",
  has scopeNote "Seed instances include fixed, duplicate, won't-fix, not-planned, cannot-reproduce, and invalid. Resolution is distinct from closure.";
put (resource: $r30e, module: $module) isa inModule;
put (resource: $r30e, group: $group_reference) isa resourceInGroup;

