  has docKey "https://github.com/vibe-machine/ontology-vibemachine#BlocksDocumentState",
  has iri "https://github.com/vibe-machine/ontology-vibemachine#BlocksDocumentState",
  has typeLabel "BlocksDocumentState",
  has kind "entity",
  has prefLabel "BlocksDocumentState",
  has definition "Serialized Yjs CRDT state for collaborative editing. The editor reconstitutes its block tree from this state on load.",
  has scopeNote "Owns document_id (@key), yjs_state. Linked via blocksDocumentStateForSpecification. Blocks-layer infrastructure, separable into its own ontology.";
put (resource: $r61, module: $module) isa inModule;
put (resource: $r61, group: $group_blocks) isa resourceInGroup;

