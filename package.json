{
  "name": "vibemachine",
  "displayName": "vibemachine",
  "version": "0.3.0",
  "description": "Workspace and product modeling package for Vibe Machine planning and delivery.",
  "author": "Vibe Machine",
  "license": "Apache-2.0",
  "source": "https://github.com/vibe-machine/ontology-vibemachine",
  "prefix": "vibemachine",
  "schemas": [
    {
      "name": "self-describing-schema",
      "file": "schema/self-describing-schema.tql"
    },
    {
      "name": "package-provenance",
      "file": "schema/package-provenance.tql"
    },
    {
      "name": "vibemachine",
      "file": "schema/vibemachine.tql"
    }
  ],
  "data": [
    "data/vibemachine-status-seeds.tql",
    "data/vibemachine-provenance.tql",
    "data/vibemachine-schema-docs.tql"
  ],
  "dependencies": [
    {
      "name": "gist",
      "version": ">=1.0.0"
    }
  ],
  "scripts": {
    "refresh:package-contract": "node ../ontology-gist/tools/package_contract/bootstrap_hand_authored_package.mjs .",
    "validate:bootstrap": "node tools/package_contract/validate_bootstrap.mjs",
    "test:typedb-bootstrap": "node tools/package_contract/validate_typedb_bootstrap.mjs",
    "test": "npm run validate:bootstrap && npm run test:typedb-bootstrap",
    "release": "../ontology-tooling/bin/ontology-release --repo .",
    "release:check": "../ontology-tooling/bin/ontology-release --repo . --validate-only"
  },
  "manifests": [
    "manifests/vibemachine-v0.3.0.package-manifest.json"
  ],
  "assembly": {
    "loadOrder": [
      "schema/self-describing-schema.tql",
      "schema/package-provenance.tql",
      "schema/vibemachine.tql",
      "data/vibemachine-status-seeds.tql",
      "data/vibemachine-provenance.tql",
      "data/vibemachine-schema-docs.tql"
    ],
    "generatedArtifacts": [
      "schema/self-describing-schema.tql",
      "schema/package-provenance.tql",
      "data/vibemachine-schema-docs.tql",
      "data/vibemachine-provenance.tql",
      "manifests/package-manifest.schema.json",
      "manifests/vibemachine-v0.3.0.package-manifest.json"
    ]
  },
  "provenance": {
    "manifest": "manifests/vibemachine-v0.3.0.package-manifest.json",
    "status": "bootstrap"
  },
  "legacyDocumentation": {
    "deprecatedFiles": [
      "data/vibemachine-typedoc.tql",
      "data/domains.tql",
      "data/categorize.tql"
    ],
    "status": "superseded-by-schema-resource"
  }
}
