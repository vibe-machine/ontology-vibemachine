  has definition "An organizational actor that can participate in delivery work.",
  has scopeNote "Inherited from gist. Can serve as a performer (assignsPerformer), assigner (assignmentAllocatedBy), or submitter (submissionProvidedBy).";
put (resource: $r_org, module: $module) isa inModule;
put (resource: $r_org, group: $group_people) isa resourceInGroup;

