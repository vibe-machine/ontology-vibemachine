# Migration helper: remove vibemachine schema-doc resources before reseeding.
# Apply in a write transaction against an existing database.
# manifest: manifests/vibemachine-v1.3.4.package-manifest.json

match
  $module isa SchemaModule, has moduleKey "vibemachine";
  $link isa inModule (resource: $resource, module: $module);
delete
  $link;
  $resource;

match
  $module isa SchemaModule, has moduleKey "vibemachine";
delete
  $module;
