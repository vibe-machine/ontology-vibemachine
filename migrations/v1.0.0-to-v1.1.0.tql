  has typeLabel "blocksAppearanceForSpecification",
  has kind "relation",
  has prefLabel "blocksAppearanceForSpecification",
  has definition "Links a blocks appearance specification to the specification it describes.",
  has scopeNote "Sub isAbout. Roles: appearance (isAboutSubject), specification (isAboutObject). Both VibeFeatureSpecification and VibeProductSpecification play the specification role.";
put (resource: $r62, module: $module) isa inModule;
